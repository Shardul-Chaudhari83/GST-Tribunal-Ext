{
  "manifest_version": 3,
  "name": "GST Appellate Tribunal - Case PDF Organizer",
  "version": "1.0.0",
  "description": "Scans the GST Appellate Tribunal e-filing 'Submitted Documents' page and downloads a merged PDF per case, organized into GST Appellate Tribunal/<Case Title>/ folders.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GST Tribunal PDF Organizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://efiling.gstat.gov.in/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://efiling.gstat.gov.in/submittedDoc.drt*"],
      "js": ["vendor/pdf-lib.min.js", "scraper.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
